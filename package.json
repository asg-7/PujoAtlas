{
  "name": "pujo-pathfinder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "astro dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "astro build && tsc --noEmit",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vercel": "^7.8.2",
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^6.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^4.15.0",
    "fastify": "^4.28.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supercluster": "^9.1.0",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.14.9",
    "@types/supercluster": "^7.1.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
