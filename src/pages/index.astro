---
import MapUIOverlay from '../components/MapUIOverlay';
import 'maplibre-gl/dist/maplibre-gl.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Pujo Pathfinder</title>
        <style>
            body, html { margin: 0; padding: 0; overflow: hidden; width: 100%; height: 100%; background: #111; }
        </style>
	</head>
	<body class="bg-gray-900 text-white font-sans overflow-hidden w-full h-full relative">
		
        <!-- Map Container -->
        <div id="map-container" class="absolute inset-0 z-0 w-full h-full"></div>

        <!-- React UI Overlay -->
        <MapUIOverlay client:load />

        <!-- Standard bundled ES module script -->
        <script>
            import { initApp } from '../lib/map/initMap';

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initApp);
            } else {
                initApp();
            }
        </script>
	</body>
</html>
