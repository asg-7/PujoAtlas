---
import MapUIOverlay from '../components/MapUIOverlay';
import 'maplibre-gl/dist/maplibre-gl.css';
import '../styles/tokens.css';

const rawBase = import.meta.env.BASE_URL ?? '/';
const baseUrl = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const siteOrigin = 'https://asg-7.github.io';
const sitePath = baseUrl.replace(/\/$/, '');
const canonicalUrl = `${siteOrigin}${sitePath}/`;
const ogImageUrl = `${siteOrigin}${baseUrl}og-image.png`;
---

<!DOCTYPE html>
<html lang="bn" data-theme="raat">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#16100E" />

		<!-- Primary SEO & Title -->
		<title>Pujo Atlas | কলকাতার সেরা দুর্গোৎসব পরিক্রমা</title>
		<meta name="title" content="Pujo Atlas | Kolkata Durga Puja Map & Directory" />
		<meta name="description" content="Discover 737 verified pandals, 213 heritage food spots, 5 metro lines, and 13 curated walking trails across Kolkata with real-time routing & smart filters." />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Icons & Webmanifest -->
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg?v=2`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32x32.png?v=2`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon-16x16.png?v=2`} />
		<link rel="shortcut icon" href={`${baseUrl}favicon.ico?v=2`} />
		<link rel="alternate icon" type="image/x-icon" href={`${baseUrl}favicon.ico?v=2`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png?v=2`} />
		<link rel="manifest" href={`${baseUrl}manifest.webmanifest?v=2`} />

		<!-- Mobile & Web App Capable -->
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Pujo Atlas" />
		<meta name="application-name" content="Pujo Atlas" />

		<!-- Open Graph / Facebook / WhatsApp -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="Pujo Atlas" />
		<meta property="og:title" content="Pujo Atlas | কলকাতার সেরা দুর্গোৎসব পরিক্রমা" />
		<meta property="og:description" content="Discover 737 verified pandals, 213 heritage food spots, 5 metro lines, and 13 curated walking trails across Kolkata with interactive shortest routes." />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Pujo Atlas — Kolkata Durga Puja Map & Directory with 737 pandals, 213 food spots, 5 metro lines, and 13 curated trails" />
		<meta property="og:locale" content="bn_IN" />
		<meta property="og:locale:alternate" content="en_IN" />

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content="Pujo Atlas | Kolkata Durga Puja Map & Guide" />
		<meta name="twitter:description" content="Discover 737 verified pandals, 213 heritage food spots, 5 metro lines, and 13 curated walking trails across Kolkata." />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content="Pujo Atlas — Interactive Durga Puja Map of Kolkata" />
		
		<!-- Font preconnects -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+Bengali:wght@400;500;600&family=Noto+Serif+Bengali:wght@500;600&display=swap" rel="stylesheet" />

		<style>
			body, html {
				margin: 0;
				padding: 0;
				overflow: hidden;
				width: 100%;
				height: 100%;
				background: var(--bg-page);
				color: var(--text-main);
			}
			@supports (height: 100dvh) {
				body, html { height: 100dvh; }
			}
		</style>
	</head>
	<body class="font-body overflow-hidden w-full h-full relative selection:bg-kumkum selection:text-shola">
		<!-- Base Map Container -->
		<div id="map-container" class="absolute inset-0 z-0 w-full h-full" aria-label="Interactive Map of Kolkata Durga Puja"></div>

		<!-- UI Overlay Component -->
		<MapUIOverlay client:load />

		<!-- Initialization Script -->
		<script>
			import { initApp } from '../lib/map/initMap';

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initApp);
			} else {
				initApp();
			}
		</script>
	</body>
</html>
